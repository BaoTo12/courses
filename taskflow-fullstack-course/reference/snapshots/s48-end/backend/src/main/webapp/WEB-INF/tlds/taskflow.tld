<?xml version="1.0" encoding="UTF-8"?>
<!--
  S44 (44.12–44.14): TaskFlow's own tag library. Jasper finds it by scanning WEB-INF/ for *.tld files; pages use it with
    <%@ taglib prefix="tf" uri="urn:taskflow:tags" %>
  The uri is only a NAME that must match: it's never downloaded.
-->
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
  <tlib-version>1.0</tlib-version>
  <short-name>tf</short-name>
  <uri>urn:taskflow:tags</uri>

  <tag>
    <description>A LocalDate in the request's language, medium style ("Oct 3, 2026"); "—" for null.</description>
    <name>date</name>
    <tag-class>com.taskflow.web.tags.DateTag</tag-class>
    <body-content>empty</body-content>
    <attribute>
      <name>value</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.time.LocalDate</type>
    </attribute>
  </tag>

  <tag>
    <description>"Due today", "Due in 3 days", "2 days overdue", from the resource bundle.</description>
    <name>relativeTime</name>
    <tag-class>com.taskflow.web.tags.RelativeTimeTag</tag-class>
    <body-content>empty</body-content>
    <attribute>
      <name>value</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.time.LocalDate</type>
    </attribute>
    <attribute>
      <name>today</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.time.LocalDate</type>
    </attribute>
  </tag>

  <function>
    <description>Cuts a text to at most max characters, ending with "…".</description>
    <name>truncate</name>
    <function-class>com.taskflow.web.tags.Functions</function-class>
    <function-signature>java.lang.String truncate(java.lang.String, int)</function-signature>
  </function>
</taglib>
