<%--
  The top of every page, pasted in at TRANSLATION time by <%@ include file="…" %> (33.10).
  S34: no Java; ${pageTitle} is a REQUEST attribute set by the controller (EL can't see local variables).
  S35: JSTL. <c:out> escapes (35.04), <c:url> adds the context path (35.11). The fragment declares the tag libraries
  it uses itself, so it doesn't depend on the including page (declaring the same prefix + URI twice is allowed).
--%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><c:out value="${pageTitle}"/> · TaskFlow Admin</title>
  <link rel="stylesheet" href="<c:url value='/static/css/app.css'/>">
</head>
<body>
<div class="page">
  <header class="page__header">
    <span class="page__brand">TaskFlow Admin</span>
    <nav class="page__nav">
      <a class="page__nav-link" href="<c:url value='/tasks'/>">Tasks</a>
      <a class="page__nav-link" href="<c:url value='/tasks/new'/>">New task</a>
    </nav>
  </header>
  <main class="page__main">
